        p50_loss = compute_pinball_loss(y_eval, q50, 0.50)
        p90_loss = compute_pinball_loss(y_eval, q90, 0.90)
        
        picp = np.mean((y_eval >= q10) & (y_eval <= q90)) * 100.0
        mpiw = np.mean(q90 - q10)
        
        prob_records.append({
            'Model': model_name,
            'Horizon': horizon,
            'Pinball Loss (P10)': p10_loss,
            'Pinball Loss (P50)': p50_loss,
            'Pinball Loss (P90)': p90_loss,
            'PICP (80% Nominal)': picp,
            'Avg Interval Width (Tonnes)': mpiw
        })

