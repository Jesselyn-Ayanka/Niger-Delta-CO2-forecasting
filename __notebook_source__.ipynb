# 4. BUILD SPATIAL ADJACENCY MATRIX (Scikit-Learn Fix)

from sklearn.metrics.pairwise import haversine_distances

def build_spatial_adjacency(centroids_gdf, k=8, sigma=25.0):
    # sklearn haversine expects coordinates in radians (Latitude, Longitude)
    coords_rad = np.radians(centroids_gdf[['latitude', 'longitude']].values)

    # Calculate pairwise haversine distances and multiply by Earth's radius in km
    dist_km = haversine_distances(coords_rad) * 6371.0088

    # Apply Gaussian heat kernel
    adj = np.exp(-(dist_km ** 2) / (sigma ** 2))
    np.fill_diagonal(adj, 0.0) # Zero self-loops

    # Apply k-NN thresholding
    adj_thresh = np.zeros_like(adj)
    for i in range(len(adj)):
        top_k_idx = np.argsort(adj[i])[-k:]
        adj_thresh[i, top_k_idx] = adj[i, top_k_idx]

    # Symmetrize the matrix for undirected graph convolutions
    adj_symmetric = np.maximum(adj_thresh, adj_thresh.T)
    return adj_symmetric, dist_km

adj_matrix_8, dist_matrix_km = build_spatial_adjacency(site_centroids, k=8, sigma=25.0)
