#Step 1 - Spatial Clustering & Reconstruction
def build_flare_panel(firms_dir, eps_meters=750, min_samples=10):
    csv_files = glob.glob(f"{firms_dir}/**/*.csv", recursive=True)
    if not csv_files:
        raise FileNotFoundError(f"No CSV files found in {firms_dir}")

    print(f"Loading {len(csv_files)} FIRMS CSV file(s)...")
    cols_to_use = ['latitude', 'longitude', 'acq_date', 'frp', 'type']

    dfs = []
    for f in csv_files:
        try:
            dfs.append(pd.read_csv(f, usecols=lambda c: c in cols_to_use))
        except Exception:
            dfs.append(pd.read_csv(f))

    df_raw = pd.concat(dfs, ignore_index=True)
    df_raw['acq_date'] = pd.to_datetime(df_raw['acq_date'])

    # Enforce precise spatial bounds (Niger Delta / Offshore domain)
    df_bounded = df_raw[
        (df_raw['longitude'] >= 4.0) & (df_raw['longitude'] <= 9.0) &
        (df_raw['latitude'] >= 3.0) & (df_raw['latitude'] <= 6.5)
    ].copy()

    # Static industrial flaring filter (type == 2)
    if 'type' in df_bounded.columns:
        flares = df_bounded[df_bounded['type'] == 2].copy()
        if len(flares) == 0:
            flares = df_bounded.copy()
    else:
        flares = df_bounded.copy()

    print(f"Total detections within domain: {len(flares):,}")

    # DBSCAN Clustering with Haversine distance
    coords_rad = np.radians(flares[['latitude', 'longitude']].values)
    kms_per_radian = 6371.0088
    eps_rad = (eps_meters / 1000.0) / kms_per_radian

    db = DBSCAN(eps=eps_rad, min_samples=min_samples, metric='haversine', algorithm='ball_tree')
    flares['site_id'] = db.fit_predict(coords_rad)

    # Exclude noise points (-1)
    persistent = flares[flares['site_id'] != -1].copy()
    print(f"Identified {persistent['site_id'].nunique()} persistent flare sites.")

    # Aggregating daily radiant heat per site
    daily_panel = (
        persistent.groupby(['site_id', 'acq_date'])['frp']
        .sum()
        .reset_index()
        .rename(columns={'acq_date': 'date', 'frp': 'radiant_heat'})
    )

    # making site centroids stable for spatial dependency
    centroids = (
        persistent.groupby('site_id')[['latitude', 'longitude']]
        .mean()
        .reset_index()
    )
    centroids_gdf = gpd.GeoDataFrame(
        centroids,
        geometry=gpd.points_from_xy(centroids.longitude, centroids.latitude),
        crs="EPSG:4326"
    )

    return daily_panel, centroids_gdf

daily_panel, site_centroids = build_flare_panel(PATHS['firms'])


#Step 2 - CO2 Conversion and Validation
from sklearn.metrics import r2_score, mean_absolute_percentage_error
from sklearn.linear_model import LinearRegression

def calibrate_and_validate(daily_panel_df, wb_dir):
    df = daily_panel_df.copy()
    country_file = os.path.join(wb_dir, "Flare-volume-and-intensity-estimates-2012-2024.xlsx")

    if not os.path.exists(country_file):
        raise FileNotFoundError(f"Validation skipped. Could not find: {country_file}")

    print(f"Loading World Bank benchmark: {os.path.basename(country_file)}")

    # 1. Parse the World Bank Excel File
    wb_df = pd.read_excel(country_file)
    country_col = [c for c in wb_df.columns if 'country' in str(c).lower()][0]
    nga_wb = wb_df[wb_df[country_col].str.contains('Nigeria', case=False, na=False)]

    # Extract columns that are years (2012-2024)
    year_cols = [c for c in nga_wb.columns if str(c).isdigit() and 2012 <= int(c) <= 2024]
    wb_long = nga_wb.melt(id_vars=[country_col], value_vars=year_cols,
                          var_name='year', value_name='wb_bcm')
    wb_long['year'] = wb_long['year'].astype(int)

    # 2. Aggregate uncalibrated FRP by Year
    df['year'] = df['date'].dt.year
    annual_frp = df.groupby('year')['radiant_heat'].sum().reset_index()

    # 3. Merge for Calibration
    calib_df = pd.merge(annual_frp, wb_long, on='year', how='inner').dropna()

    # 4. Derive empirical calibration factor (FRP to BCM)
    # We use Linear Regression (without intercept) to find: BCM = coefficient * Annual_FRP
    X = calib_df[['radiant_heat']]
    y = calib_df['wb_bcm']
    reg = LinearRegression(fit_intercept=False).fit(X, y)
    frp_to_bcm_coef = reg.coef_[0]

    print(f"Derived FIRMS FRP to BCM Coefficient: {frp_to_bcm_coef:.8e}")

    # 5. Apply Calibration to Daily Site Panel
    # Convert derived BCM back to MSCF for the panel (1 BCM = 35,314,666.7 MSCF)
    bcm_to_mscf = 35314666.7
    df['volume_mscf'] = df['radiant_heat'] * frp_to_bcm_coef * bcm_to_mscf

    # 6. Stoichiometric CO2 Conversion
    mscf_to_m3 = 28.3168
    density_ch4 = 0.68
    co2_yield = 2.75
    methane_frac = 0.85

    base_ch4_mass = df['volume_mscf'] * mscf_to_m3 * methane_frac * density_ch4

    df['co2_kg_low'] = base_ch4_mass * 0.98 * co2_yield
    df['co2_kg_central'] = base_ch4_mass * 0.95 * co2_yield
    df['co2_kg_high'] = base_ch4_mass * 0.92 * co2_yield

    # 7. Calculate and Report New Validation Metrics
    calib_df['recon_bcm'] = reg.predict(X)
    r2 = r2_score(calib_df['wb_bcm'], calib_df['recon_bcm'])
    mape = mean_absolute_percentage_error(calib_df['wb_bcm'], calib_df['recon_bcm'])
    bias = np.mean(calib_df['recon_bcm'] - calib_df['wb_bcm'])


    print(" NEW VALIDATION METRICS (Post-Calibration)")
    print(f"R² Score:   {r2:.4f}")
    print(f"MAPE:       {mape:.2%}")
    print(f"Mean Bias:  {bias:.4f} BCM")

    return df

# Execute Validation & Calibration
daily_emissions = calibrate_and_validate(daily_panel, PATHS['world_bank'])


#STEP 3: ERA5 IMPUTATION (SUBFOLDER RECURSION)
import xarray as xr
from pykalman import KalmanFilter
def process_panel_with_era5(daily_df, centroids_gdf, era5_dir, window=14):
    nc_files = sorted(glob.glob(f"{era5_dir}/**/*.nc", recursive=True))
    if not nc_files: raise FileNotFoundError(f"No NetCDF files found in {era5_dir}")

    print(f"Accessing {len(nc_files)} ERA5 chunks via robust nested loading...")

    def fix_dims(ds):
        if 'valid_time' in ds.dims and 'time' not in ds.dims:
            ds = ds.rename({'valid_time': 'time'})
        return ds

    era5_ds = xr.open_mfdataset(
        nc_files, combine='nested', concat_dim='time', preprocess=fix_dims, chunks={'time': 100}
    )
    era5_ds = era5_ds.sortby('time').drop_duplicates(dim='time')
    cloud_var = 'tcc' if 'tcc' in era5_ds.data_vars else list(era5_ds.data_vars.keys())[0]

    processed_sites = []
    total_sites = daily_df['site_id'].nunique()

    for idx, site_id in enumerate(daily_df['site_id'].unique(), start=1):
        site_sub = daily_df[daily_df['site_id'] == site_id].set_index('date').asfreq('D')
        row_geom = centroids_gdf.loc[centroids_gdf['site_id'] == site_id].iloc[0]

        # ERA5 Cloud Mapping
        try:
            site_era5 = era5_ds[cloud_var].sel(latitude=row_geom.latitude, longitude=row_geom.longitude, method='nearest').to_series()
            site_era5.index = pd.to_datetime(site_era5.index).normalize()
            site_sub['cloud_fraction'] = site_sub.index.map(site_era5.groupby(site_era5.index).mean()).fillna(0)
        except Exception:
            site_sub['cloud_fraction'] = 0.0


        # KALMAN FILTER FIX: Proper Numpy MaskedArray construction
        # 1. Fill non-detections with 0 so the underlying array has NO NaNs
        raw_values = site_sub['co2_kg_central'].fillna(0).values

        # 2. Define obscured days (cloud cover > 80% AND zero detection)
        obscured = (site_sub['cloud_fraction'] > 0.8) & (site_sub['co2_kg_central'].fillna(0) == 0)

        # 3. Create a strict numpy MaskedArray
        measurements = np.ma.MaskedArray(raw_values, mask=obscured)

        # 4. Initialize stabilized Kalman Filter
        kf = KalmanFilter(
            transition_matrices=[1.0],
            observation_matrices=[1.0],
            initial_state_mean=np.mean(raw_values),
            n_dim_obs=1
        )

        # Only fit and smooth if we have enough unmasked valid data
        if (~obscured).sum() > 10:
            # n_iter=2 ensures it solves quickly without over-optimizing matrices into NaNs
            smoothed, _ = kf.em(measurements, n_iter=2).smooth(measurements)
            site_sub['co2_imputed'] = np.maximum(0, smoothed.flatten())
            site_sub['is_imputed'] = obscured.astype(int)
        else:
            site_sub['co2_imputed'] = raw_values
            site_sub['is_imputed'] = 0


        # Rolling MAD Anomaly Flagging
        roll_med = site_sub['co2_imputed'].rolling(window, min_periods=3).median()
        roll_mad = site_sub['co2_imputed'].rolling(window, min_periods=3).apply(lambda x: np.median(np.abs(x - np.median(x))))
        site_sub['is_anomaly'] = (site_sub['co2_imputed'] > (roll_med + 3 * roll_mad)).astype(int)

        site_sub['site_id'] = site_id
        processed_sites.append(site_sub.reset_index())

        if idx % 50 == 0 or idx == total_sites:
            print(f"ERA5 Processed: {idx}/{total_sites} sites.")

    return pd.concat(processed_sites, ignore_index=True)

# Execute the robust processing
panel_clean = process_panel_with_era5(daily_emissions, site_centroids, PATHS['era5'])


