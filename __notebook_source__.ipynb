            error_str = "N/A (Pending Eval)"
    else:
        error_str = "N/A (Missing df_preds)"
        
    attribution_records.append({
        'Event / Policy Shock': ev['Event / Policy Shock'],
        'Time Window': f"{ev['start']} to {ev['end']}",
        'Realised Emission Change': ev['realised'],
        'Model Attribution (Importance Flag)': 'Extracted from TFT/GNN Attention Weights',
        'Forecast-Error Change in Window': error_str
    })

table5_df = pd.DataFrame(attribution_records)

display(table5_df.style.set_properties(**{'text-align': 'left'}).set_table_styles([
    {'selector': 'th', 'props': [('background-color', '#f4f4f2'), ('color', 'black'), ('font-weight', 'bold'), ('text-align', 'left')]},
    {'selector': 'td', 'props': [('text-align', 'left')]}
]))





# BONUS STEP 16: INFERENCE & "WHAT-IF" SCENARIO TESTING

print(" STEP 16: INFERENCE & SCENARIO TESTING")

# 1. Pick a single observation from your test set
sample_idx = 42  # Random day/site in the test set
base_scenario = X_test.iloc[[sample_idx]].copy()
actual_emissions = y_test.iloc[sample_idx]

# 2. Ask Question 1: What is the prediction under normal baseline conditions?
predicted_base = xgb_model.predict(base_scenario)[0]

print("\n QUESTION 1: BASELINE CONDITIONS")
print(f"What will this site emit under current conditions?")
print(f"  -> Actual Recorded Emissions:  {actual_emissions:.2f} Tonnes")
print(f"  -> Model Predicted Emissions:  {predicted_base:.2f} Tonnes")

# 3. Ask Question 2: "What if..." Scenario
hypothetical_scenario = base_scenario.copy()

if 'brent_spot_price' in hypothetical_scenario.columns:
    hypothetical_scenario['brent_spot_price'] = hypothetical_scenario['brent_spot_price'] * 0.5  # 50% price crash

if 'radiant_heat' in hypothetical_scenario.columns:
    hypothetical_scenario['radiant_heat'] = hypothetical_scenario['radiant_heat'] * 2.0  # Thermal intensity doubles

# Predict the new scenario
predicted_shock = xgb_model.predict(hypothetical_scenario)[0]

print("\n QUESTION 2: 'WHAT-IF' SHOCK SCENARIO")
print(f"What if oil prices crash by 50% and thermal flare intensity doubles?")
print(f"  -> New Predicted Emissions:    {predicted_shock:.2f} Tonnes")

# Calculate the difference
difference = predicted_shock - predicted_base
direction = "INCREASED" if difference > 0 else "DECREASED"
print(f"\nModel Conclusion: The shock {direction} emissions by {abs(difference):.2f} Tonnes.")
