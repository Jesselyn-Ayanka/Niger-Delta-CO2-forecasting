        sig_str = '-'
    else:
        delta_val = ((wape - base_wape) / base_wape) * 100
        delta_str = f'{delta_val:+.2f}%'
        p_val = diebold_mariano_pvalue(y_true, base_preds, preds)
        sig_str = format_significance(p_val)
        
    ablation_rows.append({
        'Model Variant': name,
        'RMSE': rmse,
        'WAPE (%)': wape,
        'Δ vs. Baseline (%)': delta_str,
        'DM Significance': sig_str
