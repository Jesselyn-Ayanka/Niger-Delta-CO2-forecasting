#figure 4 Spatial Concentration & Persistence (Lorenz Curve & Gini)

def plot_spatial_concentration(site_df):
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), dpi=300)

    # Panel A: Lorenz Curve
    site_totals = np.sort(site_df.groupby('site_id')['co2_imputed'].sum().values)
    cum_share = np.cumsum(site_totals) / np.sum(site_totals)
    cum_sites = np.arange(1, len(site_totals) + 1) / len(site_totals)

    ax1.plot(cum_sites, cum_share, color='navy', linewidth=2, label='Empirical Lorenz Curve')
    ax1.plot([0, 1], [0, 1], color='red', linestyle='--', label='Perfect Equality')

    # Calculate Gini
    n = len(site_totals)
    gini = (2 * np.sum(np.arange(1, n + 1) * site_totals) / (n * np.sum(site_totals))) - ((n + 1) / n)

    ax1.set_title(f"Lorenz Curve (Gini = {gini:.3f})", fontsize=11, fontweight='bold')
    ax1.set_xlabel("Cumulative Share of Sites", fontsize=10)
    ax1.set_ylabel("Cumulative Share of Emissions", fontsize=10)
    ax1.legend(loc='upper left')
    ax1.grid(True, linestyle='--', alpha=0.5)

    # Panel B: Top Emitter Persistence Heatmap (Top 20 Sites by Year)
    site_df['year'] = site_df['date'].dt.year
    pivot_annual = site_df.pivot_table(index='site_id', columns='year', values='co2_imputed', aggfunc='sum')
    top_sites = pivot_annual.sum(axis=1).nlargest(20).index

    sns.heatmap(pivot_annual.loc[top_sites], cmap='YlOrRd', ax=ax2, cbar_kws={'label': 'Annual CO₂ (Tonnes)'})
    ax2.set_title("Emission Rank Persistence of Top 20 Flare Sites", fontsize=11, fontweight='bold')
    ax2.set_xlabel("Year", fontsize=10)
    ax2.set_ylabel("Site ID", fontsize=10)

    plt.tight_layout()
    plt.savefig('Figure_4_Spatial_Concentration.png', dpi=300)
    plt.show()

