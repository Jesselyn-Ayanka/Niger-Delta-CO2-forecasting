# Convert Adjacency Matrix to PyTorch Tensor & Normalize (D^{-1/2} A D^{-1/2})
def normalize_adj(adj):
    adj = adj + np.eye(adj.shape[0]) # Add self-loops
    row_sum = np.array(adj.sum(1))
    r_inv_sqrt = np.power(row_sum, -0.5, where=row_sum>0).flatten()
    r_inv_sqrt[np.isinf(r_inv_sqrt)] = 0.0
    r_mat_inv_sqrt = np.diag(r_inv_sqrt)
    return torch.tensor(r_mat_inv_sqrt @ adj @ r_mat_inv_sqrt, dtype=torch.float32)

A_tensor = normalize_adj(adj_matrix_8)

# 3. PyTorch Graph Dataset with Sliding Temporal Windows (Using Scaled Targets)
class SpatialTemporalDataset(Dataset):
    def __init__(self, X, y, start_idx, end_idx, seq_len=14):
        self.X = torch.tensor(X[start_idx:end_idx], dtype=torch.float32) # [Time, Nodes, Features]
        self.y = torch.tensor(y[start_idx+seq_len:end_idx], dtype=torch.float32) # [Time, Nodes, 1]
        self.seq_len = seq_len

    def __len__(self):
        return len(self.X) - self.seq_len

    def __getitem__(self, idx):
        return self.X[idx : idx + self.seq_len].permute(1, 0, 2), self.y[idx]

SEQ_LEN = 14
