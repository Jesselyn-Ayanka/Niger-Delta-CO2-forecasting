#STEP 14: TEMPORAL FUSION TRANSFORMER (TFT) INTERPRETABILITY
import warnings
warnings.filterwarnings("ignore")
import lightning.pytorch as pl
from pytorch_forecasting import TimeSeriesDataSet, TemporalFusionTransformer
from pytorch_forecasting.data import GroupNormalizer
from pytorch_forecasting.metrics import QuantileLoss
import torch
import matplotlib.pyplot as plt
import seaborn as sns

print("TEMPORAL FUSION TRANSFORMER (TFT) & ATTENTION")

# 1. Force the exact features from your SHAP analysis
tft_features = [
    'lag_1', 'radiant_heat', 'roll_mean_7', 'volume_mscf',
    'month_cos', 'roll_mean_30', 'roll_std_90', 'month_sin',
    'intensity_tercile', 'roll_mean_90', 'lag_14', 'roll_std_7',
    'lag_7', 'lag_30', 'brent_spot_price', 'fx_rate',
    'wet_season', 'roll_std_30', 'year'
]

# Ensure all target features are strictly floats for the TFT
for col in tft_features:
    grid_df[col] = grid_df[col].astype(float)

max_prediction_length = 1
max_encoder_length = 14
training_cutoff = grid_df["time_idx"].max() - max_prediction_length

# 2. Define the TimeSeriesDataSet (Explicitly mapping the features)
print("Building TFT Dataset...")
training_dataset = TimeSeriesDataSet(
    grid_df[lambda x: x.time_idx <= training_cutoff],
    time_idx="time_idx",
    target="co2_imputed",
    group_ids=["site_id"],
    min_encoder_length=max_encoder_length,
    max_encoder_length=max_encoder_length,
    min_prediction_length=max_prediction_length,
    max_prediction_length=max_prediction_length,
    time_varying_known_reals=["time_idx"],
    time_varying_unknown_reals=tft_features,
    target_normalizer=GroupNormalizer(groups=["site_id"], transformation="softplus"),
    add_relative_time_idx=True,
    add_target_scales=True,
    add_encoder_length=True,
    allow_missing_timesteps=True
)

train_dataloader = training_dataset.to_dataloader(train=True, batch_size=256, num_workers=2)

# 3. Initialize & Train the TFT
print("Initializing Temporal Fusion Transformer...")
tft = TemporalFusionTransformer.from_dataset(
    training_dataset,
    learning_rate=0.03,
    hidden_size=16,
    attention_head_size=1,
    dropout=0.1,
    hidden_continuous_size=8,
    output_size=7,
    loss=QuantileLoss(),
    log_interval=10,
    reduce_on_plateau_patience=4,
)

print("Training lightweight TFT to extract attention weights...")
# Notice we disable the logger directly in the Trainer here natively
trainer = pl.Trainer(
    max_epochs=1,
    accelerator="auto",
    enable_model_summary=False,
    logger=False,
    enable_checkpointing=False
)
trainer.fit(tft, train_dataloaders=train_dataloader)

# 4. Extract Interpretability
print("\nGenerating Figure 15: TFT Variable Selection Weights...")
interpretation = tft.interpret_output(tft.predict(train_dataloader, mode="raw", return_x=True)[0], reduction="sum")

plt.figure(figsize=(10, 6), dpi=300)
tft.plot_interpretation(interpretation)
plt.title("Figure 15: TFT Variable Selection Weights", fontsize=11, fontweight='bold')
plt.tight_layout()
plt.savefig('Figure_15_TFT_Variable_Importance.png', dpi=300)
plt.show()

# 5. Extract Interpretability: TRUE 2D Attention Heatmap
print("Generating Figure 16: True Temporal Attention Heatmap...")
attention_weights = interpretation["attention"].mean(axis=0).cpu().numpy().flatten()

# Reshape into a 2D matrix (1 row, N columns) for a literal heatmap
attention_matrix = attention_weights.reshape(1, -1)
x_labels = list(range(-len(attention_weights), 0))

plt.figure(figsize=(12, 3), dpi=300)
sns.heatmap(attention_matrix, cmap='magma', annot=True, fmt=".3f",
            xticklabels=x_labels, yticklabels=False, cbar_kws={'label': 'Attention Weight'})
plt.title("Figure 16: TFT Temporal Attention Matrix (Heatmap)", fontsize=11, fontweight='bold')
plt.xlabel("Time Steps Before Prediction (Days)")
plt.tight_layout()
plt.savefig('Figure_16_TFT_Attention_Heatmap.png', dpi=300)
plt.show()


