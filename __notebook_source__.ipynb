        X_batch, y_batch = X_batch.to(device), y_batch.to(device)

        optimizer.zero_grad()
        preds = model(X_batch)
        loss = criterion(preds, y_batch)
        loss.backward()
        optimizer.step()

        epoch_loss += loss.item() * X_batch.size(0)

    print(f"Epoch [{epoch+1}/5] — Scaled Loss: {epoch_loss / len(train_loader.dataset):.4f}")

