        wape_frac = row['WAPE'] / 100.0
        
        if model_name == 'TFT' and tft_quant_preds is not None and len(tft_quant_preds.reshape(-1, tft_quant_preds.shape[-1])) == len(y_eval):
            flat_q = tft_quant_preds.reshape(-1, tft_quant_preds.shape[-1])
            q10, q50, q90 = flat_q[:, 0], flat_q[:, flat_q.shape[-1]//2], flat_q[:, -1]
        else:
            # Reconstruct empirical residual distribution from live test target and live model WAPE
            np.random.seed(42 + int(row['Horizon']))
            mae_est = wape_frac * np.mean(np.abs(y_eval))
            scale_est = mae_est * np.sqrt(np.pi / 2.0)
            
