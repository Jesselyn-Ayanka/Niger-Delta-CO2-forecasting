#STEP 12: METHODOLOGICAL RIGOR, STATISTICAL TESTS & HETEROGENEITY
import scipy.stats as stats

print("STATISTICAL TESTING (DIEBOLD-MARIANO) & BOX PLOTS")

# 1. Diebold-Mariano Test (XGBoost vs. ST-GCN)
# Using Absolute Error as the loss differential
def diebold_mariano_test(y_true, pred1, pred2):
    e1 = np.abs(y_true - pred1)
    e2 = np.abs(y_true - pred2)
    d = e1 - e2 # Differential loss
    mean_d = np.mean(d)
    var_d = np.var(d, ddof=1)

    # DM Statistic
    stat = mean_d / np.sqrt(var_d / len(d))
    # Two-tailed p-value
    p_value = 2 * (1 - stats.norm.cdf(abs(stat)))
    return stat, p_value

# Assuming xgb_preds and st_preds_arr are in memory (align lengths if necessary)
# For demonstration, we will slice them to match lengths if they differ due to windowing
min_len = min(len(y_test), len(preds_arr)) # preds_arr is currently ST-GCN
y_true_matched = y_test.values[:min_len]
xgb_preds_matched = xgb_model.predict(X_test)[:min_len]
st_preds_matched = preds_arr[:min_len]

dm_stat, dm_p_val = diebold_mariano_test(y_true_matched, xgb_preds_matched, st_preds_matched)

print("DIEBOLD-MARIANO TEST RESULTS")
print(f"  Null Hypothesis: XGBoost and ST-GCN have equal predictive accuracy.")
print(f"  DM Statistic: {dm_stat:.4f}")
print(f"  p-value:      {dm_p_val:.4e}")
if dm_p_val < 0.05:
    print("  Conclusion:   Reject Null. The accuracy difference is STATISTICALLY SIGNIFICANT.")
else:
    print("  Conclusion:   Fail to reject. No significant difference in accuracy.")

