def diebold_mariano_pvalue(real, pred_base, pred_comp):
    e_base = real - pred_base
    e_comp = real - pred_comp
    d = (e_base ** 2) - (e_comp ** 2)
    mean_d = np.mean(d)
    var_d = np.var(d, ddof=1)
    if var_d == 0:
        return 1.0
    dm_stat = mean_d / np.sqrt(var_d / len(d))
    return 2 * (1 - stats.norm.cdf(np.abs(dm_stat)))

def format_significance(p_val):
    if p_val < 0.001:
        return 'p < 0.001 (***)'
    elif p_val < 0.01:
        return 'p < 0.01 (**)'
    elif p_val < 0.05:
        return 'p < 0.05 (*)'
    return f'p = {p_val:.3f} (ns)'

