#Value of Spatial Dependency (RQ2),
#Spatial Autocorrelation (Moran's I Scatter & Cross-Correlation Decay)

def plot_spatial_autocorrelation(site_df, centroids_gdf, adj_matrix):
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), dpi=300)

    # 1. Calculate site mean emissions
    site_means = site_df.groupby('site_id')['co2_imputed'].mean().values
    z = site_means - np.mean(site_means)
    z_std = z / np.std(z)

    # Spatial lag vector (W * z)
    w_z = np.dot(adj_matrix, z_std) / adj_matrix.sum(axis=1, keepdims=True).squeeze()

    # Panel A: Moran Scatterplot
    ax1.scatter(z_std, w_z, color='darkblue', alpha=0.7, edgecolor='k')
    ax1.axhline(0, color='gray', linestyle='--')
    ax1.axvline(0, color='gray', linestyle='--')

    # Fit regression line for Moran's I slope
    slope, intercept = np.polyfit(z_std, w_z, 1)
    ax1.plot(z_std, intercept + slope * z_std, color='red', label=f"Moran's I = {slope:.3f}")

    ax1.set_title("Moran Scatter Plot of Site Mean Emissions", fontsize=11, fontweight='bold')
    ax1.set_xlabel("Standardized Site Emissions (z)", fontsize=10)
    ax1.set_ylabel("Spatially Lagged Neighbor Emissions (Wz)", fontsize=10)
    ax1.legend(loc='upper left')
    ax1.grid(True, linestyle='--', alpha=0.5)

    # Panel B: Distance Decay Cross-Correlation
    # Merge centroids with site means to get precise coordinates aligned to site order
    coords_df = site_df.groupby('site_id')['co2_imputed'].mean().reset_index()
    coords_df = coords_df.merge(centroids_gdf[['site_id', 'latitude', 'longitude']], on='site_id')
    coords = coords_df[['latitude', 'longitude']].values

    from sklearn.metrics.pairwise import haversine_distances
    dist_matrix = haversine_distances(np.radians(coords)) * 6371.0088

    # Compute correlation between site time series across distances
    pivot_ts = site_df.pivot_table(index='date', columns='site_id', values='co2_imputed').corr().values

    distances = dist_matrix.flatten()
    correlations = pivot_ts.flatten()

    ax2.scatter(distances, correlations, alpha=0.2, color='gray', s=10)
    ax2.set_title("Empirical Spatio-Temporal Cross-Correlation vs. Distance", fontsize=11, fontweight='bold')
    ax2.set_xlabel("Inter-Site Geodesic Distance (km)", fontsize=10)
    ax2.set_ylabel("Pearson Correlation Coefficient (r)", fontsize=10)
    ax2.set_xlim(0, 500)
    ax2.grid(True, linestyle='--', alpha=0.5)

    plt.tight_layout()
    plt.savefig('Figure_8_Spatial_Autocorrelation.png', dpi=300)
    plt.show()

plot_spatial_autocorrelation(site_daily_panel, site_centroids, adj_matrix_8)


from scipy.optimize import curve_fit
from sklearn.metrics.pairwise import haversine_distances

print("Generating Binned Spatio-Temporal Cross-Correlation Decay Plot...")

# 1. Calculate pairwise distances in km
coords_df = site_daily_panel.groupby('site_id')['co2_imputed'].mean().reset_index()
coords_df = coords_df.merge(site_centroids[['site_id', 'latitude', 'longitude']], on='site_id')
coords_rad = np.radians(coords_df[['latitude', 'longitude']].values)
dist_matrix = haversine_distances(coords_rad) * 6371.0088

# 2. Compute Pearson correlation between all site time series
pivot_ts = site_daily_panel.pivot_table(index='date', columns='site_id', values='co2_imputed').corr().values

# 3. Extract the upper triangle to avoid self-pairs (distance 0) and duplicate pairs
iupper = np.triu_indices(dist_matrix.shape[0], k=1)
distances = dist_matrix[iupper]
correlations = pivot_ts[iupper]

# Filter out any potential NaNs (e.g., if a site had completely flat/zero variance predictions)
valid_mask = ~np.isnan(correlations) & ~np.isnan(distances)
distances = distances[valid_mask]
correlations = correlations[valid_mask]

# 4. Bin the distances (10 km bins up to 500 km)
max_dist = min(500, distances.max())
bins = np.arange(0, max_dist + 10, 10)
bin_centers = (bins[:-1] + bins[1:]) / 2

binned_corr = []
for i in range(len(bins)-1):
    mask = (distances >= bins[i]) & (distances < bins[i+1])
    if np.any(mask):
        binned_corr.append(np.mean(correlations[mask]))
    else:
        binned_corr.append(np.nan)

binned_corr = np.array(binned_corr)

# Clean NaNs from bins before fitting
valid_bins = ~np.isnan(binned_corr)
x_fit = bin_centers[valid_bins]
y_fit = binned_corr[valid_bins]

# 5. Fit an exponential decay curve: y = a * exp(-b * x) + c
def exp_decay(x, a, b, c):
    return a * np.exp(-b * x) + c

try:
    # Initial parameter guess: a = range, b = mild decay, c = minimum
    p0 = (max(y_fit) - min(y_fit), 0.01, min(y_fit))
    popt, _ = curve_fit(exp_decay, x_fit, y_fit, p0=p0, maxfev=5000)
    fit_line = exp_decay(x_fit, *popt)
    fit_label = f"Fitted Exp. Decay"
except Exception as e:
    print(f"Exponential fit failed: {e}. Falling back to polynomial.")
    popt = np.polyfit(x_fit, y_fit, 2)
    fit_line = np.polyval(popt, x_fit)
    fit_label = "Fitted Decay Curve (Poly)"

# 6. Plot the results
plt.figure(figsize=(9, 5), dpi=300)

# Optional: Plot raw scatter lightly in the background to show distribution
plt.scatter(distances, correlations, alpha=0.1, color='gray', s=5, label='Raw Pairwise Correlations')

# Plot the Binned Means
plt.scatter(x_fit, y_fit, color='#1f77b4', s=50, edgecolor='k', zorder=5, label='Binned Mean Correlation (10km)')

# Plot the Fitted Curve
plt.plot(x_fit, fit_line, color='red', linewidth=3, zorder=10, label=fit_label)

plt.title("Empirical Spatio-Temporal Cross-Correlation vs. Inter-Site Distance", fontsize=12, fontweight='bold')
plt.xlabel("Inter-Site Geodesic Distance (km)", fontsize=10)
plt.ylabel("Pearson Correlation Coefficient (r)", fontsize=10)
plt.xlim(0, max_dist)
plt.grid(True, linestyle='--', alpha=0.5)
plt.legend(loc='upper right', fontsize=10)

plt.tight_layout()
plt.savefig('Figure_8b_Binned_CrossCorrelation_Decay.png', dpi=300)
plt.show()





