def assemble_full_dataset(panel_df, cbn_dir, eic_dir, policy_file):
    df = panel_df.copy()
    df['date'] = pd.to_datetime(df['date'])

    # ---------------- EIC PARSER ----------------
    eic_files = glob.glob(f"{eic_dir}/*.*")
    if eic_files:
        try:
            eic_df = pd.read_excel(eic_files[0]) if eic_files[0].endswith(('.xls', '.xlsx')) else pd.read_csv(eic_files[0], skiprows=lambda x: x < 4)
            m_cands = [c for c in eic_df.columns if any(k in str(c).lower() for k in ['month', 'date', 'period'])]
            month_col = m_cands[0] if m_cands else eic_df.columns[0]

            p_cands = [c for c in eic_df.columns if any(k in str(c).lower() for k in ['brent', 'price', 'value', 'fob'])]
            price_col = p_cands[0] if p_cands else eic_df.columns[1]

            eic_df = eic_df.rename(columns={month_col: 'date', price_col: 'brent_spot_price'})
            eic_df['date'] = pd.to_datetime(eic_df['date'], errors='coerce')
            eic_df = eic_df[['date', 'brent_spot_price']].sort_values('date').dropna(subset=['date'])
        except Exception as e:
            print(f"EIC parse error: {e}")
            eic_df = pd.DataFrame()
    else:
        eic_df = pd.DataFrame()

    # ---------------- CBN CLEAN CSV PARSER ----------------
    cbn_files = glob.glob(f"{cbn_dir}/*.*")
    # Filter out hidden files
    cbn_files = [f for f in cbn_files if not f.split('/')[-1].startswith('~$')]
    
    if cbn_files:
        try:
            # Dynamically choose the correct reader based on the file extension
            if cbn_files[0].endswith('.csv'):
                cbn_df = pd.read_csv(cbn_files[0])
            else:
                cbn_df = pd.read_excel(cbn_files[0])
                
            d_col = 'Date'

            # Identify all the FX rate columns (everything except the Date column)
            rate_cols = [c for c in cbn_df.columns if c != d_col]

            # Parse dates
            cbn_df['date'] = pd.to_datetime(cbn_df[d_col], errors='coerce')

            # Calculates a single blended macroeconomic rate, ignoring NaNs automatically
            cbn_df['fx_rate'] = cbn_df[rate_cols].mean(axis=1, skipna=True)

            
            cbn_df = cbn_df.dropna(subset=['date', 'fx_rate'])
            cbn_df = cbn_df[['date', 'fx_rate']].sort_values('date')
        except Exception as e:
            print(f"CBN parse error: {e}")
            cbn_df = pd.DataFrame()
    else:
        cbn_df = pd.DataFrame()

    # ---------------- POLICY EVENTS TIMELINE (DEFENSIVE XLSX PARSER) ----------------
    if os.path.exists(policy_file):
        try:
            policy_df = pd.read_excel(policy_file)
            policy_df.columns = policy_df.columns.str.strip().str.lower()

            if 'date' not in policy_df.columns:
                policy_df = policy_df.rename(columns={policy_df.columns[0]: 'date'})

            policy_df['date'] = pd.to_datetime(policy_df['date'], errors='coerce')
            policy_df = policy_df.dropna(subset=['date'])

            evt_cols = ['date', 'event_pres', 'policy_eve', 'operationa', 'divestmen',
                        'covid_ever', 'ngfcp_eve', 'trans_forc', 'ngfcp_201', 'flare_regul',
                        'covid_lock', 'covid_phas', 'oml17_dive', 'pia_2021_o', 'mpnu_acq', 'spdc_dive']

            val_cols = [c for c in evt_cols if c in policy_df.columns]

            if 'date' in val_cols:
                policy_df = policy_df[val_cols].sort_values('date').drop_duplicates(subset=['date'], keep='last')
            else:
                policy_df = pd.DataFrame()
        except Exception as e:
            print(f"Policy Timeline parse error: {e}")
            policy_df = pd.DataFrame()
    else:
        policy_df = pd.DataFrame()

    # ---------------- MERGE PROTOCOL ----------------
    df['day_of_week'] = df['date'].dt.dayofweek
    df['month_sin'] = np.sin(2 * np.pi * df['date'].dt.month / 12)
    df['month_cos'] = np.cos(2 * np.pi * df['date'].dt.month / 12)
    df['wet_season'] = df['date'].dt.month.isin([4, 5, 6, 7, 8, 9, 10]).astype(int)

    df = df.sort_values('date')
    if not cbn_df.empty:
        df = pd.merge_asof(df, cbn_df, on='date', direction='backward')
    if not eic_df.empty:
        df = pd.merge_asof(df, eic_df, on='date', direction='backward')

    if not policy_df.empty:
        df = pd.merge(df, policy_df, on='date', how='left')
        b_cols = [c for c in policy_df.columns if c != 'date']
        df[b_cols] = df[b_cols].fillna(0).astype(int)

    return df

print("Assembling Exogenous Features")
assembled_panel = assemble_full_dataset(panel_clean, PATHS['cbn'], PATHS['eic'], PATHS['policy'])


# 2. FEATURE ENGINEERING WITH STRICT LEAKAGE PREVENTION

def build_engineered_features(df):
    df = df.sort_values(['site_id', 'date']).reset_index(drop=True)
    target = 'co2_imputed'

    for lag in [1, 7, 14, 30]:
        df[f'lag_{lag}'] = df.groupby('site_id')[target].shift(lag)

    shifted = df.groupby('site_id')[target].shift(1)

    for w in [7, 30, 90]:
        df[f'roll_mean_{w}'] = shifted.groupby(df['site_id']).transform(lambda x: x.rolling(w, min_periods=3).mean())
        df[f'roll_std_{w}']  = shifted.groupby(df['site_id']).transform(lambda x: x.rolling(w, min_periods=3).std())

    site_intensity = df.groupby('site_id')[target].transform('mean')
    df['intensity_tercile'] = pd.qcut(site_intensity, q=3, labels=[1, 2, 3]).astype(int)

    return df.dropna().reset_index(drop=True)

