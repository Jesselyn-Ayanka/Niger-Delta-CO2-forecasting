# 2. Spatial Concentration (Gini)
def compute_gini(values):
    v_sorted = np.sort(values)
    n = len(values)
    index = np.arange(1, n + 1)
    return (2 * np.sum(index * v_sorted) / (n * np.sum(v_sorted))) - ((n + 1) / n)

site_totals = site_daily_panel.groupby('site_id')['co2_imputed'].sum().values
gini_val = compute_gini(site_totals)

# 3. Stationarity Tests
adf_stat, adf_p, _, _, _, _ = adfuller(stl_series)
kpss_stat, kpss_p, _, _ = kpss(stl_series, regression='c', nlags='auto')

# 4. Hurst Exponent (R/S Analysis)
def compute_hurst(ts):
    lags = range(10, 300)
    tau = [np.sqrt(np.std(np.subtract(ts[lag:], ts[:-lag]))) for lag in lags]
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0] * 2.0

hurst_val = compute_hurst(stl_series.values)


#STEP 6 SPATIAL DIAGNOSTICS AND AUTOCORRELATION
# 5. Spatial Autocorrelation (Global Moran's I) using your Haversine Matrix
site_means = site_daily_panel.groupby('site_id')['co2_imputed'].mean().values
z = site_means - np.mean(site_means)

# Row-standardize your existing Haversine adjacency matrix
row_sums = adj_matrix_8.sum(axis=1, keepdims=True)
row_sums[row_sums == 0] = 1.0 # Prevent division by zero
W_row_std = adj_matrix_8 / row_sums

s0 = np.sum(W_row_std)
n_sites = len(site_means)

moran_num = n_sites * np.sum(W_row_std * np.outer(z, z))
global_moran_i = moran_num / (s0 * np.sum(z ** 2))

np.random.seed(42)
perm_morans = [
    (n_sites * np.sum(W_row_std * np.outer(zp, zp))) / (s0 * np.sum(z ** 2))
    for zp in [np.random.permutation(z) for _ in range(999)]
]
moran_p = (np.sum(np.array(perm_morans) >= global_moran_i) + 1) / 1000

