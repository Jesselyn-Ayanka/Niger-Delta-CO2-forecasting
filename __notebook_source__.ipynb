train_loader = DataLoader(train_ds, batch_size=32, shuffle=False)
test_loader = DataLoader(test_ds, batch_size=32, shuffle=False)

# 4. Define ST-GCN Architecture
class STGCN(nn.Module):
    def __init__(self, in_features, hidden_dim, adj):
        super(STGCN, self).__init__()
        self.register_buffer('A', adj)
        self.spatial_conv = nn.Linear(in_features, hidden_dim)
        self.temporal_gru = nn.GRU(hidden_dim, hidden_dim, batch_first=True)
        self.fc = nn.Linear(hidden_dim, 1)

    def forward(self, x):
        batch_size, n_nodes, seq_len, feat_dim = x.shape
        x_flat = x.permute(0, 2, 1, 3).reshape(batch_size * seq_len, n_nodes, feat_dim)

        support = torch.matmul(self.A.to(x.device), x_flat)
        spatial_out = F.relu(self.spatial_conv(support))

        spatial_out = spatial_out.reshape(batch_size, seq_len, n_nodes, -1).permute(0, 2, 1, 3)
        spatial_out = spatial_out.reshape(batch_size * n_nodes, seq_len, -1)

        _, h_n = self.temporal_gru(spatial_out)
        h_n = h_n.squeeze(0).reshape(batch_size, n_nodes, -1)

        out = self.fc(h_n)
        return out

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
st_model = STGCN(in_features=n_features, hidden_dim=32, adj=A_tensor).to(device)
optimizer = torch.optim.Adam(st_model.parameters(), lr=0.002)
criterion = nn.MSELoss()

# 5. Training Loop
